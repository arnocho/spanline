# One still of each screen, for the README and for design review.
# Regenerate with: vhs docs/still.tape

Output docs/stills.gif

Set FontSize 15
Set Width 1180
Set Height 640
Set Padding 24
Set Theme "Catppuccin Mocha"
Set TypingSpeed 40ms

Type "spanline cockpit --fixtures estate"
Enter
Sleep 3200ms
Screenshot docs/overview.png

Tab
Sleep 2400ms
Screenshot docs/incident.png

Tab
Sleep 2200ms
Screenshot docs/impact.png

Type "?"
Sleep 1800ms
Screenshot docs/keys.png

Escape
Sleep 300ms
Type "q"
Sleep 600ms
