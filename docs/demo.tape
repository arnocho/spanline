# Recording script for the spanline interface, played by charmbracelet/vhs.
# Regenerate with: vhs docs/demo.tape

Output docs/demo.gif

Set FontSize 15
Set Width 1180
Set Height 720
Set Padding 24
Set Theme "Catppuccin Mocha"
Set TypingSpeed 55ms

Type "spanline cockpit --fixtures estate"
Sleep 400ms
Enter
Sleep 2600ms

Down
Sleep 700ms
Down
Sleep 700ms
Right
Sleep 2200ms
Escape
Sleep 600ms

Down
Down
Down
Sleep 900ms
Right
Sleep 2000ms
Escape
Sleep 500ms

Tab
Sleep 2600ms
Down
Sleep 600ms
Right
Sleep 2400ms
Escape
Sleep 500ms

Tab
Sleep 2400ms
Down
Sleep 600ms
Right
Sleep 2200ms
Escape
Sleep 500ms

Type "?"
Sleep 2400ms
Escape
Sleep 400ms

Type "q"
Sleep 900ms
